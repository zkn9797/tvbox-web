# TVBox Web - multi-arch (linux/amd64, linux/arm64) image. Zero npm dependencies.
# Mainland China: build with
#   --build-arg REG=docker.1ms.run/library/ --build-arg APK_MIRROR=mirrors.aliyun.com
ARG REG=
FROM ${REG}node:22-alpine AS node

FROM ${REG}alpine:3.22
ARG APK_MIRROR=
RUN if [ -n "$APK_MIRROR" ]; then sed -i "s#dl-cdn.alpinelinux.org#$APK_MIRROR#g" /etc/apk/repositories; fi \
 && apk add --no-cache libstdc++ libgcc ca-certificates tzdata \
 && addgroup -S app && adduser -S -G app app \
 && mkdir -p /data && chown app:app /data
# only the node binary from the official image (drops npm/yarn/corepack ~ 60MB)
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY server ./server
COPY public ./public
COPY assets ./assets
ENV NODE_ENV=production DATA_DIR=/data PORT=8686 TZ=Asia/Shanghai \
    NODE_TLS_REJECT_UNAUTHORIZED=0 JS_WORKERS=2 SEARCH_CONCURRENCY=5
USER app
EXPOSE 8686
VOLUME ["/data"]
HEALTHCHECK --interval=60s --timeout=5s --retries=3 CMD wget -q -O- http://127.0.0.1:8686/healthz || exit 1
CMD ["node", "--no-warnings", "--max-old-space-size=96", "--max-semi-space-size=2", "server/index.js"]
